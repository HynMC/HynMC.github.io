---
import MainLayout from '../layouts/MainLayout.astro';
import PluginCard from '../components/PluginCard.astro';
import { plugins } from '../data/plugins';
import { site } from '../data/site';
---

<MainLayout title="HynMC — Tools for Minecraft servers">
    <section class="hero-section">
        <div class="hero-glow"></div>
        <div class="container hero-content">
            <div class="eyebrow hero-eyebrow"><span class="eyebrow-line"></span>MINECRAFT DEVELOPMENT</div>
            <h1>Tools that empower<br /><span>your Minecraft server.</span></h1>
            <p class="hero-description">
                {site.description}
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="/plugins/">Explore plugins <span aria-hidden="true">→</span></a>
                <a class="button button-secondary" href={site.github} target="_blank" rel="noreferrer">
                    <span class="github-symbol">⌘</span> View on GitHub
                </a>
            </div>
        </div>
    </section>

    <section class="section products-section">
        <div class="container">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">WHAT WE BUILD</p>
                    <h2>Our <span>plugins.</span></h2>
                    <p class="section-description">Tools designed to make Minecraft server development more flexible.</p>
                </div>
                <a class="text-link heading-link" href="/plugins/">View all plugins <span aria-hidden="true">→</span></a>
            </div>
            <div class="plugin-grid">
                <h1>No plugins available yet</h1> <!-- TODO -->
                {plugins.map((plugin) => <PluginCard plugin={plugin} />)}
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container cta-inner">
            <div>
                <p class="eyebrow">BUILD WITH HYNMC</p>
                <h2>Have an idea for your server?</h2>
                <p class="muted">Explore our projects and follow development on GitHub.</p>
            </div>
            <a class="button button-primary" href={site.github} target="_blank" rel="noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a>
        </div>
    </section>
</MainLayout>
